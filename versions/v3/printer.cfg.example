# printer.cfg - el UNICO archivo que Klipper puede escribir y el UNICO que no se
# versiona.
#
# Es dueño del bloque SAVE_CONFIG del final, donde Klipper persiste lo que
# calibra solo: la malla de cama (BED_MESH_CALIBRATE), el z_offset del probe
# (PROBE_CALIBRATE) y los PID (PID_CALIBRATE). Ese bloque gana sobre cualquier
# valor de los includes porque viene despues.
#
# Todo lo demas vive en los includes, que el rol klipper_config de nd.homelab
# despliega desde este repo en modo 0444.
#
# El deploy crea este archivo una sola vez (force: false) y despues nunca lo
# vuelve a tocar. Si hace falta rehacerlo, el backup queda en
# printer.cfg.premigracion.

[include hardware.cfg]
[include limits.cfg]

# mainsail.cfg NO esta en este repo a proposito: es un symlink a
# ~/mainsail-config/mainsail.cfg, el checkout upstream que mantiene el
# [update_manager mainsail-config] de Moonraker. Versionar una copia solo
# garantiza que derive sin que nadie se entere.
[include mainsail.cfg]

# [include timelapse.cfg]

[include macros.cfg]


# ---------------------------------------------------------------------------
# LO QUE KLIPPER CALIBRA SOLO
# ---------------------------------------------------------------------------
# Esto tiene que estar en ESTE archivo y no en un include, por una regla de
# Klipper: SAVE_CONFIG se niega a pisar un valor que venga de un [include] y
# aborta con "section 'X' option 'Y' conflicts with included value". De
# printer.cfg si lo sabe borrar, asi que de aca si puede.
#
# Los valores de abajo son solo la SEMILLA con la que arranca una maquina
# nueva. En cuanto corras PID_CALIBRATE o PROBE_CALIBRATE y guardes, el bloque
# SAVE_CONFIG del final los pisa y estos quedan de adorno.
#
# La malla no esta aca porque no la necesita: [bed_mesh default] es una seccion
# que no existe en ningun include, asi que SAVE_CONFIG la escribe sin conflicto.
#
#   CALIBRAR_PID_NOZZLE   -> pitido -> SAVE_CONFIG
#   CALIBRAR_PID_CAMA     -> pitido -> SAVE_CONFIG
#   PROBE_CALIBRATE       -> TESTZ Z=-0.05 ... -> ACCEPT -> SAVE_CONFIG

# MEDIDO en esta maquina el 2026-08-30 con CALIBRAR_PID_NOZZLE: 215 grados y
# el ventilador de pieza a full, que es el peor caso termico y la condicion
# real de una pared exterior de PLA.
#
# ES UNA ELECCION, NO UN OLVIDO: un PID sintonizado contra una perturbacion
# fuerte tiene ganancia alta, y el ABS imprime con el ventilador entre 0 y 15%
# (las primeras tres capas, en 0). Ese mismo lazo sobreactua sin la
# perturbacion y puede dar overshoot de varios grados justo en las capas que
# deciden si la pieza se pega. Klipper tiene UN PID por calentador y el
# material de todos los dias es el PLA, asi que gana el PLA.
#
# Si el ABS muestra ese overshoot, la medicion para ese caso es M106 S38 (15%)
# + CALIBRAR_PID_NOZZLE TARGET=255. Los dos juegos no pueden coexistir: hay
# que elegir cual se guarda.
[extruder]
control: pid
pid_Kp: 27.091
pid_Ki: 2.544
pid_Kd: 72.130

# MEDIDO en esta maquina el 2026-08-30 con CALIBRAR_PID_CAMA a 60 grados.
# Los de fabrica eran 71.867 / 1.536 / 840.843: la cama real resulto bastante
# mas lenta y mas inercial de lo que asumia ese perfil (Kd casi 50% mas alto,
# Ki la mitad), que es justo lo que se espera de una chapa de aluminio con PEI
# encima y un calentador de cama entera.
[heater_bed]
control: pid
pid_Kp: 64.636
pid_Ki: 0.830
pid_Kd: 1257.970

# MEDIDO, y se conserva a proposito. Viene de una calibracion anterior al
# re-home en caliente de START_PRINT, pero el cambio real es chico: antes el
# G28 pasaba con el nozzle a 150 y ahora a 215, o sea 65 K sobre unos 30 mm de
# acero = 30 x 65 x 12e-6 ~ 0.023 mm, en direccion de quedar un pelin mas cerca
# de la cama. Eso esta dentro del error del propio metodo del papel, que la doc
# de Klipper estima en 0.05-0.1 mm: rehacerlo no daba un numero mejor, daba uno
# distinto con la misma incertidumbre.
#
# El otro cambio, zero_reference_position, ya esta contemplado: la malla se
# recalibro despues de ponerlo, asi que Klipper sondeo 110,110 y normalizo todo
# contra ese punto.
#
# Si alguna vez la primera capa sale sistematicamente aplastada o despegada, el
# ajuste correcto es babystepear hasta que quede bien y despues promoverlo con
# Z_OFFSET_APPLY_PROBE + SAVE_CONFIG. Un babystep suelto no sobrevive:
# START_PRINT hace SET_GCODE_OFFSET Z=0 en cada impresion.
[bltouch]
z_offset: 3.555
